{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-style.mjs\"",
            "timeout": 30,
            "statusMessage": "Contrôle de style"
          }
        ]
      }
    ]
  }
}

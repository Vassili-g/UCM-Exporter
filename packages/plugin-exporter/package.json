{
  "name": "ucm-exporter-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin Figma qui extrait un contrat UCM et des tokens DTCG. Seule la création des règles d'usage écrit dans le document.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --platform=browser --target=chrome80 --sourcemap --minify-syntax --define:__UCM_MESURE__=false",
    "build:code:mesure": "esbuild src/code.ts --bundle --outfile=dist/code.js --platform=browser --target=chrome80 --sourcemap --minify-syntax --define:__UCM_MESURE__=true",
    "build:ui:js": "esbuild src/ui/index.ts --bundle --outfile=dist/ui.js --format=iife --platform=browser --target=chrome80 --minify",
    "build:ui": "npm run build:ui:js && node scripts/build-ui.cjs",
    "build:manifest": "node scripts/build-manifest.cjs",
    "galerie": "npm run build:ui && node galerie/build-galerie.cjs",
    "galerie:captures": "node galerie/capturer.cjs",
    "test:ui": "npm run build:ui && node --test tests/interface/interface.test.mjs",
    "build": "npm run typecheck && npm run build:code && npm run build:ui && npm run build:manifest",
    "start": "npm run build",
    "test": "node scripts/run-tests.cjs"
  },
  "dependencies": {
    "@ucm-kit/core": "*",
    "ucm-plugin-socle": "*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.68.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "style-dictionary": "5.5.3"
  }
}

{
  "name": "@ucm-kit/core",
  "version": "0.1.0",
  "description": "Le format de contrat UCM et ses lecteurs : types, version, règles de nommage, schéma et validateurs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vassili-g/UCM-Exporter.git",
    "directory": "packages/kit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "schema",
    "src/lecteurs",
    "README.md"
  ],
  "exports": {
    "./format": {
      "types": "./dist/format/index.d.ts",
      "default": "./dist/format/index.js"
    },
    "./lecteurs": "./src/lecteurs/index.mjs",
    "./schema": "./schema/ucm-contract.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "schema": "tsx scripts/build-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.cjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.9.0"
  }
}

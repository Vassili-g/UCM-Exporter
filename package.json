{
  "name": "ucm-exporter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --platform=browser --target=chrome80 --sourcemap",
    "build:ui:js": "esbuild src/ui/index.js --bundle --outfile=dist/ui.js --format=iife --platform=browser --target=chrome80 --minify",
    "build:ui": "npm run build:ui:js && node scripts/build-ui.js",
    "build:manifest": "node scripts/build-manifest.js",
    "build": "npm run typecheck && npm run build:code && npm run build:ui && npm run build:manifest",
    "start": "npm run build",
    "test": "node scripts/run-tests.js",
    "schema": "tsx scripts/build-schema.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.68.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.3"
  }
}

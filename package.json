{
  "name": "ucm-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "npm run test --workspaces --if-present && node scripts/run-tests.cjs",
    "build": "npm run build --workspace @ucm-kit/core && npm run build --workspace ucm-exporter-plugin",
    "schema": "npm run schema --workspace @ucm-kit/core",
    "start": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.3"
  }
}

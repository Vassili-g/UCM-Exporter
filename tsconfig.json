{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Le test de liens balaie la documentation du monorepo, qui vit à la
    // racine : il ne dépend d'aucun paquet, et n'est donc dans aucun des deux.
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["tests/**/*", "scripts/**/*"]
}
